# Модель диспетчера: haiku (быстрее) или sonnet
DZHARVIS_MODEL=haiku
# Голос edge-tts для озвучки ответов (включается файлом golos рядом с сервером)
DZHARVIS_GOLOS=ru-RU-DmitryNeural
# Файл с материалами режима доклада и папка с заметками режима матана
DZHARVIS_ZASHCHITA=
DZHARVIS_MATAN=
# Имя терминала Claude Code, куда пересылать вопросы режима матана
MATAN_SESSIYA=МАТАН
